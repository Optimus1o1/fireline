# FIRELINE Environment Configuration
# Copy this file to .env.local and populate the secrets.
# DO NOT commit .env.local to version control.

# Supabase / PostgreSQL Connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DATABASE_URL=postgresql://postgres:password@localhost:5432/fireline

# Gemini / LLM Grounded Synthesis (Optional for offline fallback)
GEMINI_API_KEY=your-gemini-api-key-here

# Application Configuration
NEXT_PUBLIC_APP_ENV=development

